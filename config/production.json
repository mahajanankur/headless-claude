{
    "runner": {
        "mode": "docker",
        "sandbox": "required"
    },
    "paths": {
        "dataDir": "/var/gw",
        "secretsFile": "/etc/gateway/secrets.json"
    },
    "scheduler": {
        "reaperEnabled": true,
        "retentionEnabled": true
    },
    "server": {
        "trustProxy": true
    }
}
