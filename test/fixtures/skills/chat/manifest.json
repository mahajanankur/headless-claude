{
    "name": "chat",
    "version": "1.0.0",
    "description": "General-purpose assistant for free-form questions and multi-turn conversations. Read-only, no tools beyond reading its own workspace.",
    "class": "quick",
    "defaultModel": "sonnet",
    "timeoutSec": 600,
    "maxTurns": 20,
    "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message"],
        "properties": {
            "message": { "type": "string", "minLength": 1, "maxLength": 20000 }
        }
    },
    "prompt": "Reply to the message in ./input.json.",
    "rerunSafe": true
}
