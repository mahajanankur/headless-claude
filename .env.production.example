# Copy to .env.production on the server (git-ignored, mode 0600). Used by compose.prod.yaml.
DATABASE_URL=postgres://cc_gateway:CHANGE_ME@postgres:5432/cc_gateway

# Claude credentials: a subscription token from `claude setup-token` and/or an Anthropic API key.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Required: signing key for browser stream tokens, and the key that encrypts webhook secrets at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STREAM_TOKEN_SECRET=
GW_ENCRYPTION_KEY=

# Pin the Claude Code version the runner image was built with (the worker refuses a mismatch).
CLAUDE_PINNED_VERSION=2.1.312
RUNNER_DOCKER_IMAGE=headless-claude-runner:latest
# JSON array of allowed browser origins for live streams, e.g. ["https://app.example.com"]
CORS_ORIGINS=[]

# Optional LangFuse tracing (one trace per job; no prompts/outputs unless a skill sets logContent)
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
