# Copy to .env.local (git-ignored). Loaded automatically outside production.
# With `docker compose up -d` the defaults below work as-is.

DATABASE_URL=postgres://cc_gateway:cc_gateway@127.0.0.1:5432/cc_gateway
TEST_DATABASE_URL=postgres://cc_gateway:cc_gateway@127.0.0.1:5432/cc_gateway_test

# Run jobs as local processes on this machine (development only). Without this the
# worker uses the sandboxed docker runner, even when NODE_ENV is unset.
WORKER_RUNTIME=local

# Optional LangFuse tracing (npm run setup asks; keys go in the secrets file or these variables)
# LANGFUSE_ENABLED=true
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# Optional overrides (see config/custom-environment-variables.json for the full list)
# LOG_LEVEL=debug
