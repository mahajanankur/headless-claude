# Sandbox image: one container per attempt (runner.mode = docker).
#   docker build -f Dockerfile.runner --build-arg CLAUDE_CODE_VERSION=2.1.312 -t headless-claude-runner .
FROM node:20-bookworm-slim

ARG CLAUDE_CODE_VERSION=2.1.312
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && npm cache clean --force

COPY src/worker/runners/wrapper/ccwrap.js /opt/gateway/ccwrap.js

ENV DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# The worker passes --user <uid:gid>, --read-only and the mounts; this default keeps manual runs non-root.
USER node
WORKDIR /workspace
